# Optional local shell config. Copy to charisma.env (ignored by Git),
# edit paths, then run: set -a; source config/charisma.env; set +a
FHCAL_DATA_FILE=$HOME/FHCAL_GAN/datasets/raw/fhcal_data_muons_81619_large.npz
FHCAL_VENV=$HOME/.venvs/fhcal-flow
FHCAL_MAX_PER_MODULE=600
FHCAL_EPOCHS=100
FHCAL_EVAL_NUM=2048
FHCAL_RUN_DIR=experiments/experiment
FHCAL_RESULT_DIR=results/experiment
FHCAL_FITS=experiments/gmm_fits/fitbank.npz
FHCAL_GMM_PACKETS=128
